{
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "61696151-fe48-4f5e-bf76-5682a8c1d16a"
    }
  ],
 
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "monitorflare-worker",
  "main": "worker/src/index.ts",
  "compatibility_date": "2024-02-08",
  "triggers": {
    "crons": ["* * * * *"]
  }
}
